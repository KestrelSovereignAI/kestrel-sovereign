# Ignore virtual environments
.venv_kestrel
.venv/
venv/
env/
ENV/

# Ignore local env files (contains secrets)
**/.env
**/.env.*
**/.secrets
**/.secrets.*
**/.secrets/
**/secrets/

# Ignore local kestrel.toml (local providers like llama_cpp bleed into cloud).
# Cloud images get their LLM config from docker/kestrel.cloudrun.toml instead.
kestrel.toml
kestrel.toml.bak
kestrel.toml.backup
kestrel.toml.backup-*

# Ignore credentials
**/credentials/
config/
**/*.pem
**/*.key
**/*credentials*.json
**/*service-account*.json
**/*-key.json
**/*.private.json

# Ignore database dumps. Every Dockerfile here does `COPY . .`, and
# docs/deployment/README.md tells operators to write a pre-migration dump into
# the repo root (`pg_dump --file=./kestrel-pre-scheduler-v2.dump`). Without
# these patterns that dump — conversation rows and role password hashes — is
# baked into the next image and pushed. Docker does not read .gitignore, so
# the matching rules there hide such a file from `git status` while leaving it
# in the build context; both lists have to carry it.
**/*.dump
**/*-dump.sql
**/*.sql.gz

# Ignore test data
agent_data/
agent_data_test/
agent_dbs/
trusted_agents/
test_files/

# Ignore local multi-agent config (auto-discovered in container)
multi_agent.toml
multi_agent.toml.*
llm_config.toml
llm_config.toml.*
*.bak
*.backup
*.backup-*

# Ignore local databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Ignore logs
logs/
*.log

# Ignore caches and generated local data
__pycache__/
*.pyc
.pytest_cache/
.ipfs/
**/.kestrel/
**/storage_cache/
archive/
trained_loras/
generated_images/
feedback/
playwright-report/
test-results/
demo-output/
demo-report/
docs/demo-screenshots/
.workflow-cassettes/
tests/cassettes/
*.workflow-cassette.enc
*.workflow-cassette.json

# Ignore git
.git/

# Ignore tests
tests/

# Ignore Claude agent workspace
.claude/

# Ignore IDE
.vscode/
.idea/

# Ignore OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~
