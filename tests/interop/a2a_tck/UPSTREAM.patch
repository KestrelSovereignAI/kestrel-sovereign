+
+
+class ProbeAuth(httpx.Auth):
+    """An implementor-owned auth flow, separate from transport serialization."""
+
+    def __init__(self, *, transport: str, agent_card: dict[str, Any]) -> None:
+        self.transport = transport
+        self.agent_card = agent_card
+
+    def auth_flow(self, request: httpx.Request) -> Iterator[httpx.Request]:
+        """Apply a credential without rewriting any protocol fields."""
+        request.headers["Authorization"] = "Bearer tck-test-credential"
+        yield request
+
+
+def invalid_provider(**kwargs: Any) -> str:
+    """An invalid implementor factory is a configuration failure."""
+    return "not an HTTPX Auth"
+
+
+@pytest.mark.parametrize("binding", ["jsonrpc", "http_json"])
