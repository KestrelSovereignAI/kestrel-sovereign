+    """Construct an actual transport response using the native binding type."""
+    if transport == "grpc":
+        native = ParseDict(payload, a2a_pb2.SendMessageResponse())
+        return GrpcResponse(transport="grpc", success=True, raw_response=native)
+    if transport == "jsonrpc":
+        return JsonRpcResponse(transport="jsonrpc", success=True, raw_response={
+            "jsonrpc": "2.0", "id": "request-one", "result": payload,
+        })
+    return HttpJsonResponse(transport="http_json", success=True, raw_response=payload)
+
+
+def message() -> dict[str, Any]:
+    """A valid non-text agent Message with all required fields."""
+    return {
+        "role": "ROLE_AGENT", "messageId": "reply-one",
+        "parts": [{"raw": "e30=", "mediaType": "application/json"}],
+    }
+
+
+@pytest.mark.parametrize("transport", ["grpc", "jsonrpc", "http_json"])
+def test_direct_nontext_message_is_validated(
+    transport: str, schema: JSONSchemaValidator, proto_schema: ProtoSchemaValidator,
+) -> None:
+    """The protocol allows structured replies without prescribed text."""
+    original = message()
+    values = extract_messages(response(transport, {"message": original}), transport)
+    assert values == [original]
+    assert not validate_message_structure(values[0], schema, proto_schema)
+
+
+@pytest.mark.parametrize("transport", ["grpc", "jsonrpc", "http_json"])
+def test_task_status_and_history_use_the_same_message_schema(
+    transport: str, schema: JSONSchemaValidator, proto_schema: ProtoSchemaValidator,
+) -> None:
+    """Messages retain one schema regardless of their response container."""
+    feedback = message()
+    request = {"role": "ROLE_USER", "messageId": "request-one", "parts": [{"text": "Work"}]}
+    payload = {"task": {"id": "task-one", "contextId": "context-one",
+                        "history": [request],
+                        "status": {"state": "TASK_STATE_COMPLETED", "message": feedback}}}
+    before = copy.deepcopy(payload)
+    values = extract_messages(response(transport, payload), transport)
+    assert values == [request, feedback]
+    assert all(not validate_message_structure(value, schema, proto_schema) for value in values)
+    assert payload == before
+
+
+@pytest.mark.parametrize("transport", ["grpc", "jsonrpc", "http_json"])
+@pytest.mark.parametrize("field", ["role", "messageId", "parts"])
+@pytest.mark.parametrize("container", ["direct", "status", "history"])
+def test_missing_required_message_field_fails_in_every_container(
+    transport: str, field: str, container: str, schema: JSONSchemaValidator,
+    proto_schema: ProtoSchemaValidator,
+) -> None:
+    """Neither task wrapping nor protobuf conversion hides a missing field."""
+    incomplete = message()
+    del incomplete[field]
+    if container == "direct":
+        payload = {"message": incomplete}
+    elif container == "status":
+        payload = {"task": {"status": {"message": incomplete}}}
+    else:
+        payload = {"task": {"history": [incomplete]}}
+    values = extract_messages(response(transport, payload), transport)
+    assert len(values) == 1
+    errors = validate_message_structure(values[0], schema, proto_schema)
+    native_name = a2a_pb2.Message.DESCRIPTOR.fields_by_camelcase_name[field].name
+    assert errors
+    assert any(native_name in error for error in errors)
+
+
+@pytest.mark.parametrize("transport", ["grpc", "jsonrpc", "http_json"])
+def test_empty_message_is_not_discarded(
+    transport: str, schema: JSONSchemaValidator, proto_schema: ProtoSchemaValidator,
+) -> None:
+    """Empty peer message objects must reach the required-field validator."""
+    values = extract_messages(response(transport, {"message": {}}), transport)
+    assert values == [{}]
+    assert validate_message_structure(values[0], schema, proto_schema)
+
+
+def test_unknown_transport_is_a_validation_error() -> None:
+    """An unknown binding must never return an empty successful observation."""
+    with pytest.raises(ValueError, match="Unknown transport"):
+        extract_messages(response("http_json", {"message": message()}), "unknown")
+
+
+@pytest.mark.parametrize("transport", ["jsonrpc", "http_json"])
+def test_malformed_history_is_not_treated_as_absent(transport: str) -> None:
+    """Malformed message containers fail instead of losing their evidence."""
+    with pytest.raises(ValueError, match="history must be a JSON array"):
+        extract_messages(response(transport, {"task": {"history": {}}}), transport)
+
+
+@pytest.mark.parametrize("invalid", [
+    None,
+    [],
+    {"role": "ROLE_AGENT", "messageId": 42, "parts": [{"text": "reply"}]},
+    {"role": "ROLE_AGENT", "messageId": "reply", "parts": "reply"},
+    {"role": "ROLE_INVALID", "messageId": "reply", "parts": [{"text": "reply"}]},
+    {"role": "ROLE_AGENT", "messageId": "reply", "parts": [{"text": "reply", "raw": "e30="}]},
+    {"role": "ROLE_AGENT", "messageId": "\ud800", "parts": [{"text": "reply"}]},
+])
+def test_message_schema_and_proto_parse_failures_are_reported(
+    invalid: Any, schema: JSONSchemaValidator, proto_schema: ProtoSchemaValidator,
+) -> None:
+    """Malformed peer JSON fails with diagnostics instead of escaping validation."""
+    before = copy.deepcopy(invalid)
+    assert validate_message_structure(invalid, schema, proto_schema)
+    assert invalid == before
diff --git a/tests/unit/validators/test_task_state_responses.py b/tests/unit/validators/test_task_state_responses.py
new file mode 100644
index 0000000000000000000000000000000000000000..208bda7da3c262b345d7e26aa85bbabce612e653
--- /dev/null
+++ b/tests/unit/validators/test_task_state_responses.py
@@ -0,0 +1,88 @@
+"""Task-state prerequisites accept native GetTask and SendMessage containers."""
+
+from __future__ import annotations
+
+import json
+
+from http.server import BaseHTTPRequestHandler
+from typing import Any
+
+import pytest
+
+from google.protobuf.json_format import ParseDict
+
+from specification.generated import a2a_pb2
+from tck.requirements.base import TASK_STATE_WORKING
+from tck.transport.grpc_client import GrpcResponse
+from tck.transport.http_json_client import HttpJsonClient, HttpJsonResponse
+from tck.transport.jsonrpc_client import JsonRpcClient, JsonRpcResponse
+from tck.validators.payload import validate_task_state
+from tests.compatibility._task_helpers import create_working_task
+from tests.unit.transport.test_http_json_client import running_server
+
+
+@pytest.mark.parametrize("transport", ["grpc", "jsonrpc", "http_json"])
+@pytest.mark.parametrize("wrapped", [False, True])
+@pytest.mark.parametrize("state", ["TASK_STATE_WORKING", "TASK_STATE_SUBMITTED"])
+def test_task_state_handles_both_native_result_containers(
+    transport: str, wrapped: bool, state: str,
+) -> None:
+    """A GetTask result has no SendMessageResponse payload wrapper."""
+    task = {"id": "active-task", "contextId": "context", "status": {"state": state}}
+    payload = {"task": task} if wrapped else task
+    if transport == "grpc":
+        native = ParseDict(payload, a2a_pb2.SendMessageResponse() if wrapped else a2a_pb2.Task())
+        response = GrpcResponse(transport=transport, success=True, raw_response=native)
+    elif transport == "jsonrpc":
+        response = JsonRpcResponse(transport=transport, success=True, raw_response={
+            "jsonrpc": "2.0", "id": "request-one", "result": payload,
+        })
+    else:
+        response = HttpJsonResponse(transport=transport, success=True, raw_response=payload)
+    errors = validate_task_state(response, transport, TASK_STATE_WORKING)
+    assert bool(errors) == (state != "TASK_STATE_WORKING")
+
+
+@pytest.mark.parametrize("client_class", [JsonRpcClient, HttpJsonClient])
+def test_working_prerequisite_polls_the_actual_task_after_immediate_submission(
+    client_class: type[JsonRpcClient | HttpJsonClient],
+) -> None:
+    """Actual HTTP I/O observes SUBMITTED then an unwrapped WORKING GetTask."""
+    observed: list[tuple[str, dict[str, Any]]] = []
+
+    class TaskServer(BaseHTTPRequestHandler):
+        def do_GET(self) -> None:
+            self.do_POST()
+
+        def do_POST(self) -> None:
+            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
+            is_rpc = client_class is JsonRpcClient
+            sending = body.get("method") == "SendMessage" if is_rpc else self.path.endswith("/message:send")
+            params = body.get("params", {}) if is_rpc else body
+            observed.append(("send" if sending else "get", params))
+            task = {"id": "active-task", "contextId": "context", "status": {
+                "state": "TASK_STATE_SUBMITTED" if sending else "TASK_STATE_WORKING",
+            }}
+            payload = {"task": task} if sending else task
+            result = {"jsonrpc": "2.0", "id": body["id"], "result": payload} if is_rpc else payload
+            content = json.dumps(result).encode()
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(content)))
+            self.end_headers()
+            self.wfile.write(content)
+
+        def log_message(self, format: str, *args: Any) -> None:
+            pass
+
+    with running_server(TaskServer) as url:
+        client = client_class(url)
+        try:
+            info = create_working_task(client)
+        finally:
+            client.close()
+    assert info.task_id == "active-task"
+    assert info.context_id == "context"
+    assert [operation for operation, _ in observed] == ["send", "get"]
+    assert observed[0][1]["configuration"] == {"returnImmediately": True}
+    assert observed[0][1]["message"]["messageId"].startswith("tck-working-")
