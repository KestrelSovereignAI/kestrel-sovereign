+@pytest.mark.parametrize("error_code", [TASK_NOT_FOUND_ERROR.jsonrpc_code, TASK_NOT_CANCELABLE_ERROR.jsonrpc_code, None])
+def test_cancel_missing_task_requires_exact_not_found_error(error_code: int | None) -> None:
