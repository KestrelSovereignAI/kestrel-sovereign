index 0000000000000000000000000000000000000000..8d802082d336ae0005bd54788c6ec99dccb0d77c
--- /dev/null
+++ b/tests/unit/requirements/test_compatibility_probe_contracts.py
@@ -0,0 +1,94 @@
+"""Collected probes respect normative levels and native error representations."""
+
+from __future__ import annotations
+
+import ast
+import importlib
+import inspect
+import json
+import textwrap
+
+from http.server import BaseHTTPRequestHandler
+from pathlib import Path
+from typing import TYPE_CHECKING, Any
+
+import pytest
+
+from tck.reporting.collector import CompatibilityCollector
+from tck.transport.http_json_client import HttpJsonClient
+from tests.unit.transport.test_http_json_client import running_server
+
+
+if TYPE_CHECKING:
+    from collections.abc import Iterator
+
+
+def compatibility_probes() -> Iterator[tuple[Any, Any, set[str]]]:
+    """Discover actual pytest methods declaring a registry requirement."""
+    root = Path(__file__).resolve().parents[3]
+    for path in sorted((root / "tests/compatibility").rglob("test_*.py")):
+        module = importlib.import_module(".".join(path.relative_to(root).with_suffix("").parts))
+        for _, cls in inspect.getmembers(module, inspect.isclass):
+            if cls.__module__ != module.__name__ or not cls.__name__.startswith("Test"):
+                continue
+            for name, method in inspect.getmembers(cls, inspect.isfunction):
+                if not name.startswith("test_"):
+                    continue
+                source = ast.parse(textwrap.dedent(inspect.getsource(method)))
+                for node in ast.walk(source):
+                    if not isinstance(node, ast.Assign) or not isinstance(node.value, ast.Name):
+                        continue
+                    if not any(isinstance(target, ast.Name) and target.id == "req" for target in node.targets):
+                        continue
+                    requirement = vars(module).get(node.value.id)
+                    if requirement is None or not hasattr(requirement, "level"):
+                        continue
+                    marks = [*getattr(cls, "pytestmark", []), *getattr(method, "pytestmark", [])]
+                    levels = {mark.name for mark in marks} & {"must", "should", "may"}
+                    yield getattr(cls(), name), requirement, levels
+
+
+def test_actual_probe_filters_match_the_registry_obligations() -> None:
+    """A MUST run cannot silently enforce SHOULD obligations or omit MUSTs."""
+    checked = []
+    for method, requirement, levels in compatibility_probes():
+        assert levels == {requirement.level.value.lower()}, (method.__qualname__, requirement.id, levels)
+        checked.append(requirement.id)
+    assert checked
+
+
+@pytest.mark.parametrize("media_type", ["application/a2a+json", "application/json"])
+def test_every_mandatory_http_error_format_probe_accepts_native_errors(media_type: str) -> None:
+    """Exercise every collected ERR-001 producer, including cross-binding ones."""
+    class NativeErrorServer(BaseHTTPRequestHandler):
+        def do_GET(self) -> None:
+            body = json.dumps({"error": {"code": 404, "status": "NOT_FOUND", "message": "missing", "details": [
+                {"@type": "type.googleapis.com/google.rpc.ErrorInfo", "reason": "TASK_NOT_FOUND", "domain": "a2a-protocol.org"},
+            ]}}).encode()
+            self.send_response(404)
+            self.send_header("Content-Type", media_type)
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+        def log_message(self, format: str, *args: Any) -> None:
+            pass
+
+    checked = []
+    with running_server(NativeErrorServer) as url:
+        client = HttpJsonClient(url)
+        try:
+            for method, requirement, _ in compatibility_probes():
+                if requirement.id != "HTTP_JSON-ERR-001":
+                    continue
+                collector = CompatibilityCollector()
+                try:
+                    method(transport_clients={"http_json": client}, compatibility_collector=collector)
+                except pytest.skip.Exception as error:
+                    pytest.fail(f"Mandatory native error-format probe skipped: {error}")
+                assert collector.get_results()
+                assert all(result.passed and not result.skipped for result in collector.get_results())
+                checked.append(method.__qualname__)
+        finally:
+            client.close()
+    assert checked
