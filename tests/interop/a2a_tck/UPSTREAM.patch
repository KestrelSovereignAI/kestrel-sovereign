+def extract_messages(result: dict[str, Any]) -> list[Any]:
+    """Collect actual Message objects in either valid SendMessage result form.
+
+    A2A 3.1.1 permits Task or Message; 4.1.4 applies the same Message schema
+    to direct replies, status messages and task history. Preserve malformed
+    message values for the schema validator rather than dropping them.
