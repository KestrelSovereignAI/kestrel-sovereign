diff --git a/tck/transport/http_auth.py b/tck/transport/http_auth.py
new file mode 100644
index 0000000..0375bb6
--- /dev/null
+++ b/tck/transport/http_auth.py
@@ -0,0 +1,33 @@
+"""Explicit implementor-supplied HTTP authentication for the compatibility run."""
+
+from __future__ import annotations
+
+import importlib
+
+from typing import Any
+
+import httpx
+
+
+def create_http_auth(provider: str | None, *, transport: str, agent_card: dict[str, Any]) -> httpx.Auth | None:
+    """Load ``module:factory`` and request an HTTPX Auth for one HTTP binding.
+
+    The factory receives keyword arguments ``transport`` and ``agent_card``.
+    It owns credentials, discovery and extension-specific signing. The TCK
+    retains all request/response assertions and never changes the SUT's policy.
+    """
+    if provider is None:
+        return None
+    module_name, separator, attribute = provider.partition(":")
+    if not separator or not module_name or not attribute.isidentifier():
+        msg = "HTTP authentication provider must be module:factory"
+        raise ValueError(msg)
+    factory = getattr(importlib.import_module(module_name), attribute)
+    if not callable(factory):
+        msg = f"HTTP authentication provider {provider!r} is not callable"
+        raise TypeError(msg)
+    auth = factory(transport=transport, agent_card=agent_card)
+    if not isinstance(auth, httpx.Auth):
+        msg = f"HTTP authentication provider {provider!r} must return httpx.Auth"
+        raise TypeError(msg)
+    return auth
diff --git a/tck/transport/http_client.py b/tck/transport/http_client.py
new file mode 100644
index 0000000..9f73040
--- /dev/null
+++ b/tck/transport/http_client.py
@@ -0,0 +1,40 @@
+"""One owned HTTP session for native operations and raw compatibility probes."""
+
+from __future__ import annotations
+
+from typing import Any
+from urllib.parse import urlsplit, urlunsplit
+
+import httpx
+
+from tck.transport._helpers import A2A_VERSION, A2A_VERSION_HEADER
+from tck.transport.base import BaseTransportClient
+
+
+class HttpTransportClient(BaseTransportClient):
+    """Preserve configured authentication on every HTTP request, including SSE."""
+
+    def __init__(self, base_url: str, transport: str, *, auth: httpx.Auth | None = None, tenant: str = "") -> None:
+        super().__init__(base_url, transport, tenant=tenant)
+        self._client = httpx.Client(
+            base_url=base_url,
+            timeout=httpx.Timeout(5.0, read=30.0),
+            headers={A2A_VERSION_HEADER: A2A_VERSION},
+            follow_redirects=True,
+            auth=auth,
+        )
+
+    def request_http(self, method: str, url: str, **kwargs: Any) -> httpx.Response:
+        """Send an unmodified raw probe with this client's authentication."""
+        return self._client.request(method, url, **kwargs)
+
+    def service_url(self, path: str = "") -> str:
+        """Preserve the declared endpoint prefix and query when adding a path."""
+        if not path:
+            return self.base_url
+        parts = urlsplit(self.base_url)
+        return urlunsplit(parts._replace(path=parts.path.rstrip("/") + path))
+
+    def close(self) -> None:
+        """Close the original HTTP session."""
+        self._client.close()
