+"""Real HTTP authentication reaches native, streaming and raw TCK probes."""
+
+from __future__ import annotations
+
+import json
+
+from http.server import BaseHTTPRequestHandler
+from pathlib import Path
+from typing import TYPE_CHECKING, Any
+
+import httpx
+import pytest
+
+from tck.transport.http_auth import create_http_auth
+from tck.transport.http_json_client import HttpJsonClient
+from tck.transport.jsonrpc_client import JsonRpcClient
+from tests.unit.transport.test_http_json_client import running_server
+
+
+if TYPE_CHECKING:
+    from collections.abc import Iterator
+
+
+pytest_plugins = ["pytester"]
+
+
+class ProbeAuth(httpx.Auth):
+    """An implementor-owned auth flow, separate from transport serialization."""
+
+    def __init__(self, *, transport: str, agent_card: dict[str, Any]) -> None:
+        self.transport = transport
+        self.agent_card = agent_card
+
+    def auth_flow(self, request: httpx.Request) -> Iterator[httpx.Request]:
+        """Apply a credential without rewriting any protocol fields."""
+        request.headers["Authorization"] = "Bearer tck-test-credential"
+        yield request
+
+
+def invalid_provider(**kwargs: Any) -> str:
+    """An invalid implementor factory is a configuration failure."""
+    return "not an HTTPX Auth"
+
+
+@pytest.mark.parametrize("binding", ["jsonrpc", "http_json"])
+def test_provider_receives_the_actual_card_and_transport(binding: str) -> None:
+    """An auth factory can scope its credentials using actual discovery."""
+    card = {"name": "trusted fixture", "supportedInterfaces": []}
+    auth = create_http_auth(f"{__name__}:ProbeAuth", transport=binding, agent_card=card)
+    assert isinstance(auth, ProbeAuth)
+    assert auth.transport == binding
+    assert auth.agent_card is card
+
+
+@pytest.mark.parametrize("provider,exception", [
+    ("missing-separator", ValueError), ("module:", ValueError), (":factory", ValueError),
+    ("module:factory.nested", ValueError), ("tck_auth_missing_module:factory", ModuleNotFoundError),
+    ("builtins:missing_auth_provider", AttributeError), ("builtins:None", TypeError),
+    (f"{__name__}:invalid_provider", TypeError),
+])
+def test_invalid_provider_fails_instead_of_downgrading_to_anonymous(provider: str, exception: type[Exception]) -> None:
+    """Bad auth configuration never becomes an anonymous conformance run."""
+    with pytest.raises(exception):
+        create_http_auth(provider, transport="jsonrpc", agent_card={})
+
+
+def test_authentication_is_explicitly_optional_for_public_agents() -> None:
+    """Public servers retain their anonymous client configuration."""
+    assert create_http_auth(None, transport="jsonrpc", agent_card={}) is None
+
+
+@pytest.mark.parametrize("client_class", [JsonRpcClient, HttpJsonClient])
+@pytest.mark.parametrize("operation", ["native", "streaming", "raw"])
+@pytest.mark.parametrize("authenticated", [False, True])
+def test_all_http_probe_paths_keep_authentication_and_original_input(
+    client_class: type[JsonRpcClient | HttpJsonClient], operation: str, authenticated: bool,
+) -> None:
+    """Every original wire request uses the configured HTTPX auth flow."""
+    observed = []
+
+    class AuthenticatedServer(BaseHTTPRequestHandler):
+        def do_GET(self) -> None:
+            self.do_POST()
+
+        def do_POST(self) -> None:
+            body = self.rfile.read(int(self.headers.get("Content-Length", 0)))
+            observed.append((self.path, body, self.headers.get("A2A-Version"), self.headers.get("Content-Type")))
+            accepted = self.headers.get("Authorization") == "Bearer tck-test-credential"
+            streaming = "text/event-stream" in self.headers.get("Accept", "")
+            if accepted and streaming:
+                response = b'data: {"authenticated": true}\n\n'
+            else:
+                response = json.dumps({"error": {"code": 404 if accepted else 401, "message": "task not found" if accepted else "authentication required"}}).encode()
+            self.send_response((404 if self.command == "GET" else 200) if accepted else 401)
+            self.send_header("Content-Type", "text/event-stream" if accepted and streaming else "application/json")
+            self.send_header("Content-Length", str(len(response)))
+            self.end_headers()
+            self.wfile.write(response)
+
+        def log_message(self, format: str, *args: Any) -> None:
+            pass
+
+    auth = ProbeAuth(transport="fixture", agent_card={}) if authenticated else None
+    with running_server(AuthenticatedServer) as url:
+        client = client_class(url, auth=auth)
+        try:
+            if operation == "raw":
+                response = client.request_http(
+                    "POST", url, content=b"{intentionally malformed", headers={"Content-Type": "text/plain", "A2A-Version": "99.0"},
+                )
+                assert response.status_code == (200 if authenticated else 401)
+                assert observed == [("/", b"{intentionally malformed", "99.0", "text/plain")]
+            elif operation == "streaming":
+                result = client.send_streaming_message({"messageId": "auth-stream", "role": "ROLE_USER", "parts": [{"text": "probe"}]})
+                try:
+                    assert result.status_code == (200 if authenticated else 401)
+                    assert list(result.events) == ([{"authenticated": True}] if authenticated else [])
+                finally:
+                    if isinstance(result.raw_response, httpx.Response):
+                        result.raw_response.close()
+            else:
+                result = client.get_task("auth-task")
+                expected_status = (404 if client_class is HttpJsonClient else 200) if authenticated else 401
+                assert result.status_code == expected_status
+                assert ("task not found" if authenticated else "authentication required") in result.error
+        finally:
+            client.close()
+    assert len(observed) == 1
+
+
+def test_compatibility_fixture_wires_authentication_and_selected_tenant(pytester: pytest.Pytester) -> None:
+    """Discovery must carry both authentication and the selected tenant into actual I/O."""
+    observed = []
+
+    class FixtureServer(BaseHTTPRequestHandler):
+        def do_GET(self) -> None:
+            if self.path == "/.well-known/agent-card.json":
+                base = f"http://127.0.0.1:{self.server.server_port}"
+                body = {"supportedInterfaces": [
+                    {"protocolBinding": "JSONRPC", "url": base + "/rpc", "tenant": "selected"},
+                    {"protocolBinding": "JSONRPC", "url": base + "/ignored", "tenant": "ignored"},
+                    {"protocolBinding": "HTTP+JSON", "url": base + "/rest", "tenant": "selected"},
+                ]}
+                self.respond(200, body)
+            else:
+                self.do_POST()
+
+        def do_POST(self) -> None:
+            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
+            authorization = self.headers.get("Authorization")
+            observed.append((authorization, self.path, body))
+            authorized = authorization == "Bearer tck-test-credential"
+            rpc = self.path == "/rpc"
+            error = {"code": -32001 if rpc else 404, "message": "authorized missing task" if authorized else "authentication required"}
+            response = {"jsonrpc": "2.0", "id": body["id"], "error": error} if rpc else {"error": error}
+            self.respond((200 if rpc else 404) if authorized else 401, response)
+
+        def respond(self, status: int, body: dict[str, Any]) -> None:
+            encoded = json.dumps(body).encode()
+            self.send_response(status)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(encoded)))
+            self.end_headers()
+            self.wfile.write(encoded)
+
+        def log_message(self, format: str, *args: Any) -> None:
+            pass
+
+    project = Path(__file__).resolve().parents[3]
+    pytester.makeconftest(f"import sys\nsys.path.insert(0, {str(project)!r})\npytest_plugins = ['tests.compatibility.conftest']\n")
+    pytester.makepyfile('''
+def test_authenticated_bindings(transport_clients):
+    assert set(transport_clients) == {"jsonrpc", "http_json"}
+    for client in transport_clients.values():
+        response = client.get_task("fixture-task")
+        assert response.status_code == (200 if client.transport == "jsonrpc" else 404)
+        assert "authorized missing task" in response.error
+''')
+    with running_server(FixtureServer) as url:
+        result = pytester.runpytest_subprocess(
+            f"--sut-host={url}", "--transport=jsonrpc,http_json",
+            "--http-auth-provider=tests.unit.transport.test_http_auth:ProbeAuth", "-q", timeout=30,
+        )
+    result.assert_outcomes(passed=1)
+    assert [credential for credential, _, _ in observed] == ["Bearer tck-test-credential"] * 2
+    assert observed[0][1] == "/rpc"
+    assert observed[0][2]["params"] == {"id": "fixture-task", "tenant": "selected"}
