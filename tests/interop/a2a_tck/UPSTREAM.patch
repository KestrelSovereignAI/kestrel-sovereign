@@ -0,0 +1,171 @@
+"""Selected Agent Interface tenants reach actual native HTTP and gRPC requests."""
+
+from __future__ import annotations
+
+import json
+
+from concurrent.futures import ThreadPoolExecutor
+from http.server import BaseHTTPRequestHandler
+from typing import Any
+from urllib.parse import parse_qs, urlsplit
+
+import grpc
+import httpx
+import pytest
+
+from google.protobuf.message_factory import GetMessageClass
+
+from specification.generated import a2a_pb2
+from tck.reporting.collector import CompatibilityCollector
+from tck.transport.grpc_client import GrpcClient
+from tck.transport.http_json_client import HttpJsonClient
+from tck.transport.jsonrpc_client import JsonRpcClient
+from tests.compatibility._test_helpers import jsonrpc_probe
+from tests.compatibility.core_operations import test_transport_behavior as metadata_checks
+from tests.compatibility.grpc import test_status_codes as grpc_checks
+from tests.unit.transport.test_http_json_client import running_server
+from tests.unit.validators.grpc.test_error_validator import status_details
+
+
+def exercise_native_operations(client: Any) -> None:
+    """Use the actual public API for every operation, including both streams."""
+    message = {"messageId": "tenant-message", "role": "ROLE_USER", "parts": [{"text": "tenant probe"}]}
+    calls = [
+        lambda: client.send_message(message),
+        lambda: client.send_streaming_message(message),
+        lambda: client.get_task("task"),
+        lambda: client.list_tasks("context"),
+        lambda: client.cancel_task("task"),
+        lambda: client.subscribe_to_task("task"),
+        lambda: client.create_push_notification_config("task", {"url": "https://callback.example"}),
+        lambda: client.get_push_notification_config("task", "config"),
+        lambda: client.list_push_notification_configs("task"),
+        lambda: client.delete_push_notification_config("task", "config"),
+        client.get_extended_agent_card,
+    ]
+    for call in calls:
+        response = call()
+        if response.is_streaming:
+            assert list(response.events) == []
+        if isinstance(response.raw_response, httpx.Response):
+            response.raw_response.close()
+
+
+@pytest.mark.parametrize("client_class", [JsonRpcClient, HttpJsonClient])
+@pytest.mark.parametrize("endpoint_path", ["/interface", "/interface/"])
+def test_every_http_operation_binds_the_selected_tenant(client_class: type[JsonRpcClient | HttpJsonClient], endpoint_path: str) -> None:
+    """JSON-RPC uses service params; HTTP+JSON uses one encoded path segment."""
+    observed = []
+
+    class TenantServer(BaseHTTPRequestHandler):
+        def do_GET(self) -> None:
+            self.do_POST()
+
+        def do_DELETE(self) -> None:
+            self.do_POST()
+
+        def do_POST(self) -> None:
+            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
+            observed.append((self.path, body))
+            rpc = client_class is JsonRpcClient
+            result = {"jsonrpc": "2.0", "id": body["id"], "error": {"code": -32001, "message": "probe"}} if rpc else {
+                "error": {"code": 404, "message": "probe"},
+            }
+            content = json.dumps(result).encode()
+            self.send_response(200 if rpc else 404)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(content)))
+            self.end_headers()
+            self.wfile.write(content)
+
+        def log_message(self, format: str, *args: Any) -> None:
+            pass
+
+    with running_server(TenantServer) as url:
+        client = client_class(url + endpoint_path + "?selection=one", tenant="tenant space")
+        try:
+            exercise_native_operations(client)
+        finally:
+            client.close()
+    assert observed
+    for path, body in observed:
+        parsed = urlsplit(path)
+        assert parse_qs(parsed.query)["selection"] == ["one"]
+        if client_class is JsonRpcClient:
+            assert parsed.path == endpoint_path
+            assert body["params"]["tenant"] == "tenant space"
+        else:
+            assert parsed.path.startswith("/interface/tenant%20space/")
+            assert "tenant" not in body
+
+
+def test_every_grpc_operation_binds_the_selected_tenant() -> None:
+    """A real generated service decodes the tenant from every protobuf request."""
+    observed = []
+    service = a2a_pb2.DESCRIPTOR.services_by_name["A2AService"]
+    handlers = {}
+    for method in service.methods:
+        def abort(request: Any, context: grpc.ServicerContext, *, name: str = method.name) -> None:
+            observed.append((name, request.tenant))
+            if dict(context.invocation_metadata()).get("a2a-version") == "99.0":
+                code = grpc.StatusCode.FAILED_PRECONDITION
+                context.set_trailing_metadata((("grpc-status-details-bin", status_details(code, "VERSION_NOT_SUPPORTED")),))
+                context.abort(code, "version observation")
+            context.abort(grpc.StatusCode.NOT_FOUND, "tenant observation")
+
+        factory = grpc.unary_stream_rpc_method_handler if method.server_streaming else grpc.unary_unary_rpc_method_handler
+        handlers[method.name] = factory(abort, request_deserializer=GetMessageClass(method.input_type).FromString)
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        server = grpc.server(executor)
+        server.add_generic_rpc_handlers((grpc.method_handlers_generic_handler(service.full_name, handlers),))
+        port = server.add_insecure_port("127.0.0.1:0")
+        server.start()
+        client = GrpcClient(f"127.0.0.1:{port}", tenant="tenant-exact")
+        try:
+            exercise_native_operations(client)
+            collector = CompatibilityCollector()
+            metadata_checks.TestGrpcServiceParams().test_extensions_metadata_accepted({"grpc": client}, collector)
+            grpc_checks.TestGrpcStatusCodes().test_version_not_supported_returns_failed_precondition({"grpc": client}, collector)
+            assert all(result.passed and not result.skipped for result in collector.get_results())
+        finally:
+            client.close()
+            server.stop(0).wait()
+    assert {name for name, _ in observed} == set(service.methods_by_name)
+    assert len(observed) == len(service.methods) + 2
+    assert all(tenant == "tenant-exact" for _, tenant in observed)
+
+
+def test_raw_jsonrpc_producers_preserve_probe_parameters_and_bind_tenant() -> None:
+    """Tenant propagation cannot repair or replace intentionally invalid input."""
+    observed = []
+
+    class RawServer(BaseHTTPRequestHandler):
+        def do_POST(self) -> None:
+            observed.append(json.loads(self.rfile.read(int(self.headers["Content-Length"]))))
+            self.send_response(200)
+            self.send_header("Content-Length", "2")
+            self.end_headers()
+            self.wfile.write(b"{}")
+
+        def log_message(self, format: str, *args: Any) -> None:
+            pass
+
+    with running_server(RawServer) as url:
+        client = JsonRpcClient(url, tenant="selected")
+        original = {"message": {"invalid": "preserved"}}
+        try:
+            jsonrpc_probe(client, "SendMessage", original)
+            jsonrpc_probe(client, "SendMessage", [])
+        finally:
+            client.close()
+    assert original == {"message": {"invalid": "preserved"}}
+    assert observed[0]["params"] == {**original, "tenant": "selected"}
+    assert observed[1]["params"] == []
+
+
+@pytest.mark.parametrize("client_class", [JsonRpcClient, HttpJsonClient, GrpcClient])
+@pytest.mark.parametrize("tenant", [False, 1, [], {}])
+def test_invalid_tenant_is_rejected_before_connecting(client_class: type[JsonRpcClient | HttpJsonClient | GrpcClient], tenant: Any) -> None:
+    """Invalid card values cannot silently turn into an unscoped request."""
+    with pytest.raises(TypeError, match="tenant must be a string"):
+        client_class("not-a-usable-address", tenant=tenant)
