--- /dev/null
+++ b/tck/transport/http_client.py
@@ -0,0 +1,40 @@
+"""One owned HTTP session for native operations and raw compatibility probes."""
+
+from __future__ import annotations
+
+from typing import Any
+from urllib.parse import urlsplit, urlunsplit
+
+import httpx
+
+from tck.transport._helpers import A2A_VERSION, A2A_VERSION_HEADER
+from tck.transport.base import BaseTransportClient
+
+
+class HttpTransportClient(BaseTransportClient):
+    """Preserve configured authentication on every HTTP request, including SSE."""
+
+    def __init__(self, base_url: str, transport: str, *, auth: httpx.Auth | None = None, tenant: str = "") -> None:
+        super().__init__(base_url, transport, tenant=tenant)
+        self._client = httpx.Client(
+            base_url=base_url,
+            timeout=httpx.Timeout(5.0, read=30.0),
+            headers={A2A_VERSION_HEADER: A2A_VERSION},
+            follow_redirects=True,
+            auth=auth,
+        )
+
+    def request_http(self, method: str, url: str, **kwargs: Any) -> httpx.Response:
+        """Send an unmodified raw probe with this client's authentication."""
+        return self._client.request(method, url, **kwargs)
+
+    def service_url(self, path: str = "") -> str:
+        """Preserve the declared endpoint prefix and query when adding a path."""
+        if not path:
+            return self.base_url
+        parts = urlsplit(self.base_url)
+        return urlunsplit(parts._replace(path=parts.path.rstrip("/") + path))
+
+    def close(self) -> None:
+        """Close the original HTTP session."""
+        self._client.close()
