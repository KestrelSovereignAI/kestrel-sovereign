+"""Real JSON-RPC probes distinguish missing tasks and unsupported part media."""
+
+from __future__ import annotations
+
+import json
+
+from contextlib import contextmanager
+from http.server import BaseHTTPRequestHandler
+from typing import TYPE_CHECKING, Any
+
+import pytest
+
+from tck.reporting.collector import CompatibilityCollector
+from tck.requirements.base import CONTENT_TYPE_NOT_SUPPORTED_ERROR, TASK_NOT_CANCELABLE_ERROR, TASK_NOT_FOUND_ERROR
+from tck.requirements.registry import get_requirement_by_id
+from tck.transport.jsonrpc_client import JsonRpcClient
+from tests.compatibility.jsonrpc import test_error_codes as rpc_checks
+from tests.unit.transport.test_http_json_client import running_server
+
+
+if TYPE_CHECKING:
+    from collections.abc import Iterator
+
+
+@contextmanager
+def replying_client(error_code: int | None) -> Iterator[tuple[JsonRpcClient, list[dict[str, Any]]]]:
+    """Use an actual HTTP server and the TCK's original JSON-RPC transport."""
+    observed = []
+
+    class RpcServer(BaseHTTPRequestHandler):
+        def do_POST(self) -> None:
+            payload = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+            observed.append({"payload": payload, "content_type": self.headers.get("Content-Type")})
+            result = {"jsonrpc": "2.0", "id": payload["id"]}
+            if error_code is not None:
+                result["error"] = {"code": error_code, "message": "Negative probe result"}
+            else:
+                task = {"id": "task", "contextId": "context", "status": {"state": "TASK_STATE_COMPLETED"}}
+                result["result"] = {"task": task} if payload["method"] == "SendMessage" else task
+            body = json.dumps(result).encode()
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+        def log_message(self, format: str, *args: Any) -> None:
+            pass
+
+    with running_server(RpcServer) as url:
+        client = JsonRpcClient(url)
+        try:
+            yield client, observed
+        finally:
+            client.close()
+
+
+@pytest.mark.parametrize("error_code", [TASK_NOT_FOUND_ERROR.jsonrpc_code, TASK_NOT_CANCELABLE_ERROR.jsonrpc_code, None])
+def test_cancel_missing_task_requires_exact_not_found_error(error_code: int | None) -> None:
+    """Success and TaskNotCancelable cannot stand in for TaskNotFound."""
+    collector = CompatibilityCollector()
+    with replying_client(error_code) as (client, observed):
+        probe = rpc_checks.TestJsonRpcErrorCodeMappings().test_cancel_missing_task_returns_task_not_found
+        try:
+            if error_code == TASK_NOT_FOUND_ERROR.jsonrpc_code:
+                probe({"jsonrpc": client}, collector)
+            else:
+                with pytest.raises(AssertionError):
+                    probe({"jsonrpc": client}, collector)
+        except pytest.skip.Exception as error:
+            pytest.fail(f"Wrong error or success must fail rather than skip: {error}")
+    result, = collector.get_results()
+    assert result.passed == (error_code == TASK_NOT_FOUND_ERROR.jsonrpc_code)
+    assert not result.skipped
+    assert len(observed) == 1 and observed[0]["payload"]["method"] == "CancelTask"
+
+
+@pytest.mark.parametrize("error_code", [CONTENT_TYPE_NOT_SUPPORTED_ERROR.jsonrpc_code, TASK_NOT_FOUND_ERROR.jsonrpc_code, None])
+def test_unsupported_media_probe_preserves_valid_json_envelope(error_code: int | None) -> None:
+    """A message-part media error is exercised with a valid HTTP Content-Type."""
+    collector = CompatibilityCollector()
+    with replying_client(error_code) as (client, observed):
+        probe = rpc_checks.TestJsonRpcErrorCodeMappings().test_content_type_not_supported_error
+        arguments = {"transport_clients": {"jsonrpc": client},
+                     "agent_card": {"defaultInputModes": ["text/plain"]},
+                     "compatibility_collector": collector}
+        try:
+            if error_code == CONTENT_TYPE_NOT_SUPPORTED_ERROR.jsonrpc_code:
+                probe(**arguments)
+            else:
+                with pytest.raises(AssertionError):
+                    probe(**arguments)
+        except pytest.skip.Exception as error:
+            pytest.fail(f"Wrong error or success must fail rather than skip: {error}")
+    result, = collector.get_results()
+    assert result.passed == (error_code == CONTENT_TYPE_NOT_SUPPORTED_ERROR.jsonrpc_code)
+    assert not result.skipped
+    assert len(observed) == 1
+    assert observed[0]["content_type"] == "application/json"
+    recipe = get_requirement_by_id("CORE-SEND-003").sample_input["message"]
+    sent = observed[0]["payload"]["params"]["message"]
+    assert sent["messageId"].startswith(recipe["messageId"] + "-")
+    assert {**sent, "messageId": recipe["messageId"]} == recipe
