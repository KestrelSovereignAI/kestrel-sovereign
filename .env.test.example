# Test Environment Configuration
# Copy this file to .env.test and fill in your values
# Then source it before running tests: source .env.test

# =============================================================================
# Database Configuration (REQUIRED)
# =============================================================================

# Local PostgreSQL for development testing
DATABASE_URL=postgresql://kestrel_user:YOUR_PASSWORD_HERE@localhost:5433/kestrel

# Cloud SQL for production testing (via Cloud SQL proxy)
CLOUD_DATABASE_URL=postgresql://kestrel:YOUR_CLOUD_PASSWORD_HERE@localhost:5432/kestrel

# =============================================================================
# Redis Configuration (REQUIRED)
# =============================================================================

REDIS_URL=redis://:YOUR_REDIS_PASSWORD_HERE@localhost:6380

# =============================================================================
# API Endpoints (Optional - defaults provided)
# =============================================================================

# Kestrel API server
BASE_URL=http://localhost:7777

# Alternative Kestrel API server (for full API tests)
KESTREL_URL=http://localhost:8080

# Kestrel Agent API server
KESTREL_URL=http://localhost:8888

# =============================================================================
# Authentication (REQUIRED for authenticated tests)
# =============================================================================

JWT_SECRET_KEY=your-jwt-secret-key-here

# =============================================================================
# External API Keys (Optional - for integration tests)
# =============================================================================

# OpenAI API key for LLM tests
OPENAI_API_KEY=sk-your-api-key-here

# OpenRouter API key for multi-model tests
OPENROUTER_API_KEY=sk-or-your-api-key-here

# =============================================================================
# Kestrel Agent Configuration (Optional)
# =============================================================================

# Encryption key for data at rest (Fernet key)
KESTREL_DATA_KEY=your-fernet-key-here

# Audit mode: strict | warn | skip
KESTREL_AUDIT_MODE=warn

# =============================================================================
# Cloud Deployment Testing (Optional)
# =============================================================================

# GCP project ID
GCP_PROJECT_ID=YOUR_PROJECT_ID

# Cloud Run service URLs
DEV_KESTREL_URL=https://dev.YOUR_DOMAIN.com
PROD_KESTREL_URL=https://YOUR_DOMAIN.com
