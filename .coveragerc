[run]
# Measure the canonical installable package, including files not imported by tests.
source =
    kestrel_sovereign

# Files and directories to omit
omit =
    */tests/*
    */.venv*/*
    */archive/*
    */__pycache__/*
    */migrations/*
    */conftest.py
    setup.py
    docs/*

# Enable branch coverage
branch = True

# Keep one data file per pytest-cov/xdist process until the controller combines
# them.  The cleanup hook must never force-exit a worker before plugin teardown.
parallel = True

[report]
# Honest ratchet from the 2026-07-25 canonical-package unit-suite measurement:
# 73.53% combined line/branch coverage (68,079 covered lines, 19,863 covered
# branches; Python 3.14.2/macOS).  The scheduled full suite includes this unit
# suite, so 73% is a conservative enforced floor.  80% remains a target, not a
# claim about current coverage.
fail_under = 73

# Show missing lines in report
show_missing = True

# Exclude lines from coverage
exclude_lines =
    # Don't complain about missing debug-only code
    pragma: no cover

    # Don't complain if tests don't hit defensive assertions
    raise AssertionError
    raise NotImplementedError

    # Don't complain if non-runnable code isn't run
    if __name__ == .__main__.:

    # Don't require coverage for abstract methods
    @abstractmethod

    # Don't require coverage for type checking blocks
    if TYPE_CHECKING:

    # Don't require coverage for protocol definitions
    @overload

# Precision of coverage percentage
precision = 2

[html]
# Output directory for HTML report
directory = coverage_html_report

[xml]
# Output file for XML report (for CI integration)
output = coverage.xml
