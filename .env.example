# Kestrel Environment Variables
# Copy this file to .env and update with your values

# OpenRouter API Key (recommended - access to multiple LLM providers)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenAI API Key (for cloud LLM fallback)
OPENAI_API_KEY=your-openai-api-key-here

# Encryption Keys (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
KESTREL_DATA_KEY=your-fernet-encryption-key-here
KESTREL_DB_KEY=optional-sqlcipher-passphrase

# Database Configuration
KESTREL_DB_PATH=./agent_data

# IPFS and Filecoin Configuration (optional)
IPFS_API_URL=http://localhost:5001
LOTUS_RPC_URL=http://localhost:1234/rpc/v0
LOTUS_RPC_TOKEN=your-lotus-token-here

# Platform Configuration
DATABASE_URL=postgresql://kestrel_user:kestrel_password@localhost:5433/kestrel
REDIS_URL=redis://:redis_password_2024@localhost:6380
JWT_SECRET_KEY=your-jwt-secret-key-here

# GitHub Configuration
GITHUB_TOKEN=your-github-personal-access-token  # For GitHub features (issues, PRs, etc.)
GITHUB_SELF_REPO=KestrelSovereignAI/kestrel-sovereign  # Agent's own source repository

# Agent Tools Configuration
TAVILY_API_KEY=your-tavily-api-key-here  # Get from https://tavily.com
