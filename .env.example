# Kestrel Environment Variables
# Copy this file to .env and update with your values

# OpenRouter API Key (recommended - access to multiple LLM providers)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenAI API Key (for cloud LLM fallback)
OPENAI_API_KEY=your-openai-api-key-here

# Encryption Keys (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
KESTREL_DATA_KEY=your-fernet-encryption-key-here
KESTREL_DB_KEY=optional-sqlcipher-passphrase

# Database Configuration
KESTREL_DB_PATH=./agent_data

# Expedient-cloud backup (GCS)
GCS_BACKUP_BUCKET=your-gcs-bucket-name
GCP_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=credentials/your-service-account.json

# Sovereign-operated IPFS is decommissioned by default. Set only after
# reprovisioning a reachable self-hosted Kubo node.
# SOVEREIGN_IPFS_URL=

# Delegated-decentralized Lighthouse / direct IPFS / Filecoin (optional)
IPFS_API_URL=http://localhost:5001
LOTUS_RPC_URL=http://localhost:1234/rpc/v0
LOTUS_RPC_TOKEN=your-lotus-token-here

# Platform Configuration
DATABASE_URL=postgresql://kestrel_user:kestrel_password@localhost:5433/kestrel
REDIS_URL=redis://:redis_password_2024@localhost:6380
JWT_SECRET_KEY=your-jwt-secret-key-here

# GitHub Configuration
GITHUB_TOKEN=your-github-personal-access-token  # For GitHub features (issues, PRs, etc.)
GITHUB_SELF_REPO=KestrelSovereignAI/kestrel-sovereign  # Agent's own source repository

# Anthropic API Key
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini API Key
GOOGLE_API_KEY=your-google-api-key-here

# CI/test-only: skip startup reachability probes for local LLM daemons
KESTREL_SKIP_REACHABILITY_PROBE=0

# Agent Tools Configuration
TAVILY_API_KEY=your-tavily-api-key-here  # Get from https://tavily.com

# Voice Providers (optional — enables cloud TTS/STT in the voice picker)
ELEVENLABS_API_KEY=  # ElevenLabs v3 TTS (inline audio tags). Get from https://elevenlabs.io/app/settings/api-keys (grant voices_read + text_to_speech)
DEEPGRAM_API_KEY=    # Deepgram STT. Get from https://console.deepgram.com

# Server Configuration
KESTREL_HOST=0.0.0.0
KESTREL_PORT=8888
KESTREL_ENV=development  # development | production
KESTREL_API_KEY=  # Auto-generated if empty

# Agent Behavior
KESTREL_MAX_TOOL_ITERATIONS=15
KESTREL_MAX_TOOL_RESULT_CHARS=4000
KESTREL_AUDIT_INTERVAL=300  # seconds between constitutional audits

# Database Backend
KESTREL_DB_BACKEND=sqlite  # sqlite | postgres
KESTREL_DATABASE_URL=  # Only needed for postgres backend

# Hugging Face (for model downloads / training)
HF_TOKEN=your-huggingface-token-here

# Lighthouse / Filecoin Storage
LIGHTHOUSE_API_KEY=your-lighthouse-api-key-here

# Vast.ai GPU Compute
VASTAI_API_KEY=your-vastai-api-key-here

# RunPod GPU Compute
RUNPOD_API_KEY=your-runpod-api-key-here

# Replicate (for training)
REPLICATE_API_TOKEN=your-replicate-token-here

# Stripe Payments (optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Wallet Safety Limits
KESTREL_TX_DAILY_LIMIT_USD=50.00
KESTREL_ALLOW_MAINNET=false
KESTREL_TX_REQUIRE_APPROVAL=true

# GCP (for Vertex AI / Cloud Compute)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Google OAuth (for Cloud Run deployments)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KESTREL_SESSION_SECRET=
KESTREL_REQUIRE_OAUTH=false

# Compute Sandbox
KESTREL_ALLOW_LOCAL_COMPUTE=false
KESTREL_COMPUTE_DEFAULT_TIMEOUT=300
KESTREL_COMPUTE_MAX_TIMEOUT=3600

# XAI / Grok
XAI_API_KEY=your-xai-api-key-here
