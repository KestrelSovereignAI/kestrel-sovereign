# Dockerfile for Kestrel MultiAgent Host — Cloud Run / Azure Container Apps
# Runs the multi-agent host (host.py) which spawns agent subprocesses.
# Same base as Dockerfile.cloudrun but entrypoint is host:app, not kestrel_sovereign.server:app.
ARG TARGETARCH
FROM ghcr.io/astral-sh/uv:latest AS uv
FROM --platform=linux/${TARGETARCH} python:3.11-slim

WORKDIR /app

# Install system dependencies. gcc + python3-dev are needed to build webrtcvad
# (C extension, pulled in by core deps after voice PR #799). Without them, uv
# pip install fails silently on the chain and the venv ends up empty.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy uv from official image (faster than pip install uv)
COPY --from=uv /uv /usr/local/bin/uv

# Copy application source code
COPY . .

# Make entrypoint executable
RUN chmod +x /app/docker/multi_agent_entrypoint.sh

# Create the virtual environment and install
# Uses Docker secret for GitHub token to access private repos (kestrel-talon)
RUN --mount=type=secret,id=github_token \
    uv venv /app/.venv && \
    GIT_AUTH="$(cat /run/secrets/github_token 2>/dev/null || true)" && \
    if [ -n "$GIT_AUTH" ]; then \
        git config --global url."https://${GIT_AUTH}@github.com/".insteadOf "https://github.com/"; \
    fi && \
    uv pip install --python /app/.venv/bin/python . && \
    uv pip install --python /app/.venv/bin/python \
        "kestrel-feature-github-app @ git+https://github.com/KestrelSovereignAI/kestrel-feature-github-app.git" && \
    (uv pip uninstall --python /app/.venv/bin/python ollama || true) && \
    git config --global --unset-all url."https://${GIT_AUTH}@github.com/".insteadOf 2>/dev/null || true

# Cloud LLM config — LLMService reads [llm] from /app/kestrel.toml directly.
COPY docker/kestrel.cloudrun.toml /app/kestrel.toml

# Cloud Run multi_agent config
COPY docker/multi_agent.cloudrun.toml /app/multi_agent.toml

# Create directories for agent data (auto-discover will find subdirs)
RUN mkdir -p /app/agent_data

# Seed SOUL.md for staging agents so bootstrap skips discovery mode on cold start
COPY docker/seed_agents/ /app/agent_data/

# Create non-root user and set permissions
RUN useradd -m -u 1000 kestrel && \
    chown -R kestrel:kestrel /app

# Switch to non-root user
USER kestrel

# Environment
ENV PYTHONUNBUFFERED=1
ENV KESTREL_ENV=production
ENV KESTREL_MULTI_AGENT_CONFIG=/app/multi_agent.toml
ENV KESTREL_HOST_AUTOSTART=true
ENV PORT=8080

# Cloud Run / ACA injects PORT env var
EXPOSE 8080

# Health check hits the host's aggregated health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Bootstrap agent identities and start the multi_agent host
CMD ["/app/docker/multi_agent_entrypoint.sh"]
