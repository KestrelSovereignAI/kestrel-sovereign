# Dockerfile for Kestrel Sovereign Agent — Isolated Local Execution
#
# This image provides cryptographic isolation between the agent and the host.
# The agent process runs in a sandbox with KESTREL_DATA_KEY but no view of
# the host filesystem; the database and any user data are mounted at /data.
#
# Distinct from docker/Dockerfile.cloudrun (Cloud Run / serverless) and
# docker/Dockerfile.rookery (multi-agent rookery on Cloud Run). Use this
# image for local sovereign deployments where the operator wants the
# agent's blast radius confined to a container.
#
# SECURITY: Use Docker Secrets instead of environment variables for the key.
# Environment variables are visible via `docker inspect` — secrets are not.
#
# Recommended Usage (Docker Secrets):
#   # Create a secrets file
#   echo "your-fernet-key" > ~/.kestrel/secrets/data_key
#   chmod 600 ~/.kestrel/secrets/data_key
#
#   # Build and run with mounted secret + LLM config
#   docker build -f docker/Dockerfile.sovereign -t kestrel-sovereign .
#   docker run -it \
#     -v ~/.kestrel/secrets/data_key:/run/secrets/kestrel_data_key:ro \
#     -v ~/.kestrel/kestrel.toml:/app/kestrel.toml:ro \
#     -v ~/emma_data:/data \
#     kestrel-sovereign
#
# Docker Swarm Usage:
#   echo "your-fernet-key" | docker secret create kestrel_data_key -
#   docker service create --secret kestrel_data_key kestrel-sovereign
#
# LLM configuration:
#   The image does NOT bake an LLM config in. Mount a populated kestrel.toml
#   at /app/kestrel.toml (see docs/architecture/LLM_SERVICE_ARCHITECTURE.md
#   and kestrel.toml.example for the [llm] schema), or run the wizard once
#   on the host and bind-mount the resulting file.
#

ARG TARGETARCH
FROM ghcr.io/astral-sh/uv:latest AS uv
FROM --platform=linux/${TARGETARCH:-amd64} python:3.11-slim

LABEL maintainer="Kestrel AI"
LABEL description="Isolated sovereign agent container"

ARG UID=1000
ARG GID=1000

WORKDIR /app

# System dependencies:
#   curl  — diagnostics
#   git   — pyproject.toml git+https:// deps (kestrel-talon, kestrel-feature-mcp)
#   gcc + python3-dev — needed to compile native extensions for core deps
#                        like webrtcvad that don't ship arm64 wheels.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install uv from the official image (faster than pip install uv).
COPY --from=uv /uv /usr/local/bin/uv

# Copy application source. .dockerignore handles exclusions (.venv, .env,
# tests, kestrel.toml, *.db, agent_data, etc. — see /.dockerignore).
COPY . .

# Install the package and its declared dependencies via pyproject.toml.
# Replaces the hand-curated dependency list this Dockerfile carried since
# the pre-extraction monolith era — that list had drifted (missing rookery,
# signals, kestrel_config, and the post-#688 LLM modules).
RUN --mount=type=secret,id=github_token \
    GIT_AUTH="$(cat /run/secrets/github_token 2>/dev/null || true)" && \
    if [ -n "$GIT_AUTH" ]; then \
        git config --global url."https://${GIT_AUTH}@github.com/".insteadOf "https://github.com/"; \
    fi && \
    uv pip install --system --no-cache . && \
    git config --global --unset-all url."https://${GIT_AUTH}@github.com/".insteadOf 2>/dev/null || true

# Create non-root user for runtime.
RUN groupadd -g $GID kestrel && \
    useradd -u $UID -g $GID -m -s /bin/bash kestrel && \
    mkdir -p /data && \
    chown -R kestrel:kestrel /app /data

# Environment
ENV PYTHONUNBUFFERED=1
ENV KESTREL_DB_PATH=/data

# Switch to non-root user
USER kestrel

# Lightweight health check — agent process can import its own package.
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import kestrel_sovereign" || exit 1

# Default: interactive chat against /data/kestrel_prime.db.
# Override with: docker run ... kestrel-sovereign kestrel <subcommand>
ENTRYPOINT ["python"]
CMD ["main.py", "/data/kestrel_prime.db"]
