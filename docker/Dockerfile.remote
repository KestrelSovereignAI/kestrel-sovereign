# Dockerfile for Kestrel Agent - Remote LLM Dependencies
# Uses external LLM services (OpenAI, etc.) - smaller image
ARG TARGETARCH
FROM --platform=linux/${TARGETARCH} python:3.11-slim

# Set environment variables for configuration
ENV KESTREL_DB_PATH=/app/kestrel.db
ENV KESTREL_IDENTITY_PATH=/app/kestrel_did.json
ENV KESTREL_ENV=production
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install uv

# Copy application source code
COPY . .

# Make startup script executable
RUN chmod +x /app/docker_entrypoint.sh

# Create the virtual environment
RUN uv venv /app/.venv

# Install the project (excluding local LLM dependencies)
RUN uv pip install --python /app/.venv/bin/python . && \
    uv pip uninstall --python /app/.venv/bin/python ollama -y || true

# Create directory for agent data if it doesn't exist
RUN mkdir -p /app/agent_data

# Expose the port the app runs on
EXPOSE 8888

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8888/health || exit 1

# Run the startup script that provides both web UI and terminal chat
CMD ["/app/docker_entrypoint.sh"]