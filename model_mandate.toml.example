# Kestrel Model Mandate Configuration

[defaults]
# The default model provider to use if no specific mandate matches.
# Options: "ollama", "openai", or a specific model name.
preferred = "ollama"

# The specific model to be used for auditing responses and code.
# This should ideally be a model trusted for its analytical and
# truth-seeking capabilities.
feedback_audit_model = "grok"

# A list of models or providers that are explicitly banned from use.
# This can be a provider name (e.g., "openai") or a specific model
# (e.g., "gpt-5").
banned = []

[mandates]
# Define rules to route specific types of queries to specific models.
# The key is a keyword or phrase that, if found in a user's prompt,
# will trigger the mandate. The value is the model or provider to use.
"truth" = "grok" # Hypothetical example from grok_says docs
"summarize" = "phi3:latest"
"code" = "codegemma:latest"
"creative" = "llama3:latest" 