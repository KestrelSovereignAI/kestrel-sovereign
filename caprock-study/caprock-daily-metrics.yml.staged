# Caprock Clinical Validation Study — Daily Metrics Pipeline
# ===========================================================
# ACTIVATION: Rename this file to caprock-daily-metrics.yml
# (remove the .staged extension) to activate automatic daily runs.
#
# Required GitHub Secrets (set in jaslogic1/RemoteCares repo settings):
#   CAPROCK_DB_HOST      — staging.onehs.net or Container App DB host
#   CAPROCK_DB_PORT      — 5432
#   CAPROCK_DB_NAME      — remotecares (or actual DB name)
#   CAPROCK_DB_USER      — read-only DB user (create one: see README.md)
#   CAPROCK_DB_PASSWORD  — DB password
#   GH_TOKEN             — GitHub token with repo scope (for weekly report)
#
# What it does (daily at 06:00 UTC):
#   1. collect_metrics.py    → snapshots/YYYY-MM-DD.json
#   2. build_cumulative.py   → cumulative.json
#   3. Commits snapshot to repo
#   4. Every Friday: weekly_report.py → posts to #58 and #44

name: Caprock Daily Metrics

on:
  schedule:
    - cron: "0 6 * * *"   # 06:00 UTC daily = midnight CT (adjust as needed)
  workflow_dispatch:        # Allow manual trigger

jobs:
  collect-and-report:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: .

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GH_TOKEN }}

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: pip install -r caprock-study/requirements.txt

      - name: Collect today's metrics
        env:
          DB_HOST:     ${{ secrets.CAPROCK_DB_HOST }}
          DB_PORT:     ${{ secrets.CAPROCK_DB_PORT }}
          DB_NAME:     ${{ secrets.CAPROCK_DB_NAME }}
          DB_USER:     ${{ secrets.CAPROCK_DB_USER }}
          DB_PASSWORD: ${{ secrets.CAPROCK_DB_PASSWORD }}
        run: |
          python caprock-study/collect_metrics.py

      - name: Rebuild cumulative tracker
        run: |
          python caprock-study/build_cumulative.py

      - name: Commit snapshot
        run: |
          git config user.name  "kestrel-bot"
          git config user.email "bot@kestrel.ai"
          git add caprock-study/snapshots/ caprock-study/cumulative.json
          git diff --cached --quiet || git commit -m "chore(study): daily metrics snapshot $(date -u +%Y-%m-%d)"
          git push

      - name: Post weekly report (Fridays only)
        if: ${{ github.event_name == 'schedule' && contains(fromJson('["Fri"]'), steps.get-day.outputs.day) || github.event_name == 'workflow_dispatch' && inputs.force_weekly_report == 'true' }}
        env:
          GH_TOKEN: ${{ secrets.GH_TOKEN }}
        run: |
          python caprock-study/weekly_report.py

      - name: Get day of week
        id: get-day
        run: echo "day=$(date +%a)" >> $GITHUB_OUTPUT
