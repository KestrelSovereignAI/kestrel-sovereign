# LLM provider configuration for Kestrel.
#
# This file configures which LLM providers are available and their fallback order.
# API keys are stored in .env (never in this file) — use api_key_env to reference them.
#
# The 'provider_priority' list determines the fallback order when routing requests.

provider_priority = ["openai", "ollama"]

# OpenAI (cloud) - Set OPENAI_API_KEY in .env
[openai]
model = "auto"
selection_hints = ["gpt-5", "mini"]

# Ollama - Local inference for privacy mode
# Install from https://ollama.ai, then: ollama pull llama3.2
[ollama]
host = "http://localhost:11434"  # Overridden by OLLAMA_HOST env var
model = "auto"
selection_hints = ["llama3.2", "qwen", "gpt-oss"]

# --- Optional providers (uncomment and add keys to .env) ---

