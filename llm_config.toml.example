# =============================================================================
# DEPRECATED: standalone llm_config.toml is on its way out (#938).
#
# New users should configure LLM providers via:
#
#     kestrel setup llm        # interactive wizard
#     # or hand-edit kestrel.toml's [llm] section
#
# Existing users with a populated llm_config.toml can migrate in one step:
#
#     kestrel migrate-llm-config
#
# (merges this file into kestrel.toml [llm], renames source to .bak)
#
# This file is kept only as a reference for the schema below; it is no
# longer recommended as the source of LLM config. The schema itself —
# vendor/route/model — remains canonical and unchanged in [llm].
# =============================================================================
#
# LLM configuration for Kestrel — vendor/route/model architecture.
#
# A **vendor** is who makes the weights (openai, anthropic, ollama, ...).
# A **route** is how to reach them (base_url + auth + adapter). A vendor may
# have several routes (e.g. anthropic:api via API key, anthropic:plan via
# Claude Max OAuth). Discovery runs once per vendor; routing is per route.
#
# See docs/architecture/LLM_SERVICE_ARCHITECTURE.md for the canonical spec.
# API keys belong in .env — reference them with api_key_env / auth_token_env.

# Fallback order. Each entry is "<vendor>:<route>". The first available route
# is used unless a mandate (persisted model preference or per-request override)
# specifies otherwise.
route_priority = [
    "openai:api",
    "ollama:local",
]


# =============================================================================
# OpenAI (cloud) — set OPENAI_API_KEY in .env
# =============================================================================

[vendors.openai]
is_cloud = true

[vendors.openai.routes.api]
adapter        = "OpenAIAdapter"
api_key_env    = "OPENAI_API_KEY"
model          = "auto"
selection_hints = ["gpt-5", "mini"]


# =============================================================================
# Ollama — local inference (install from https://ollama.ai, then `ollama pull llama3.2`)
# =============================================================================

[vendors.ollama]
is_cloud = false

[vendors.ollama.routes.local]
adapter        = "OllamaAdapter"
# OLLAMA_HOST env var overrides this host (e.g. RunPod proxy, FRP tunnel).
host           = "http://localhost:11434"
model          = "auto"
selection_hints = ["llama3.2", "qwen", "gpt-oss"]


# =============================================================================
# Optional vendors — uncomment the block and add the matching env var to .env.
# Remember to also add the vendor's "vendor:route" entry to route_priority above.
# =============================================================================

# --- Anthropic (cloud) — set ANTHROPIC_API_KEY in .env -----------------------
#[vendors.anthropic]
#is_cloud = true
#
#[vendors.anthropic.routes.api]
#adapter        = "AnthropicAdapter"
#api_key_env    = "ANTHROPIC_API_KEY"
#model          = "auto"
#selection_hints = ["sonnet", "haiku", "opus"]

# --- Claude Max (subscription) — OAuth token from `claude setup-token` -------
#[vendors.anthropic.routes.plan]
#adapter        = "ClaudeMaxAdapter"
#auth_token_env = "ANTHROPIC_AUTH_TOKEN"
#model          = "auto"
#selection_hints = ["sonnet", "opus"]

# --- OpenRouter (meta-vendor) — set OPENROUTER_API_KEY in .env ---------------
#[vendors.openrouter]
#is_cloud = true
