#[vendors.openrouter.routes.api]
#adapter        = "OpenRouterAdapter"
#base_url       = "https://openrouter.ai/api/v1"
#api_key_env    = "OPENROUTER_API_KEY"
#model          = "auto"
#selection_hints = ["deepseek", "chat"]

