# Host-local feature manifest for `kestrel feature sync`.
#
# `uv sync` makes the venv exactly match the project's declared dependencies
# and prunes anything else. Out-of-tree feature/provider packages
# (kestrel-feature-voice, kestrel-feature-github, the kestrel-voice-* family,
# …) are deliberately NOT declared in pyproject.toml — doing so would invert
# the open-core dependency direction (framework -> feature). So every
# `uv sync` removes them and the host loses voice/github/etc.
#
# This manifest is THIS host's record of which extension packages it should
# keep installed. Restore them after a prune with:
#
#     kestrel feature sync
#
# Bootstrap it from your current install instead of hand-editing:
#
#     kestrel feature sync --capture
#
# Copy this file to `.kestrel-host-features.toml` (gitignored) and edit.
#
# This file is also the SOURCE MAP the `kestrel update` reconcile step reads to
# decide each feature's update mode. Each entry records ONE source:
#   - `editable = "/path"`  -> git pull --ff-only the checkout on update
#   - `pypi = ">=x,<y"`     -> pip install --upgrade within the pin on update
#   - neither               -> install latest from PyPI (back-compat)
# `editable` and `pypi` are mutually exclusive — a feature has one source.

# The core distribution is a first-class entry here (issue #2949). Every
# `kestrel-feature-*` depends on `kestrel-sovereign`, and the installer
# (`uv pip`) is project-blind: it does not read `uv.lock`, so it treats core as
# an ordinary dependency and will resolve a wheel from PyPI whenever the
# installed version fails a feature's pin — silently replacing an editable
# checkout. Declaring core here makes its intended source explicit; `feature
# sync` and the `kestrel update` reconcile step then pin core to the checkout
# for every feature install and re-link it if anything breaks the link.
#
# Whatever you declare is applied FIRST and held for the whole batch, in
# manifest order or not:
#   - `editable = "/path"`  -> core is re-linked to that checkout, then every
#     feature install is pinned to the version that checkout builds.
#   - `pypi = ">=x,<y"`     -> core comes from the index, and features may move
#     it only WITHIN that window; one that needs more fails loudly.
#   - `pypi = ""`           -> from the index, any version: nothing is held.
# Omit the entry entirely and the live editable link (if any) is guarded anyway.
#
# This entry is a SOURCE POLICY, not a feature to load: `kestrel feature status`
# reports where core is installed from, but never gives it a per-agent column —
# dozens of bundled features share the `kestrel-sovereign` package, so no single
# column could honestly stand for all of them.
[[feature]]
name = "kestrel-sovereign"
editable = "/path/to/kestrel-sovereign"

# Install from PyPI/git via the feature registry (name resolves through
# `kestrel feature list`). A raw dist name like "kestrel-feature-voice" works
# too.
[[feature]]
name = "voice"
extras = ["local"]   # optional: pulls Piper / faster-whisper for the local pipeline

[[feature]]
name = "voice_openai"   # OpenAI TTS/STT provider (Realtime path)

# Pin a PyPI version range — reconcile upgrades within the spec, respecting the
# package's own floor pins.
[[feature]]
name = "reflection"
pypi = ">=0.3,<0.4"

# Install editable from a local checkout instead of PyPI — keeps live-editing
# the feature repo, and reconcile keeps it fresh with `git pull`. `editable`
# and `extras` may be combined.
[[feature]]
name = "github"
editable = "/Volumes/data2/projects/kestrel-feature-github"

# Fleet observability host feature. Consumes the identity→tenant resolver from
# host config key `observability_tenant_resolver` (issue #2444). Pin to the
# v0.4 seam contract that introduced the per-request resolver hook. There is no
# feature-registry alias for the fleet package, so name it by its raw dist name
# (a raw `kestrel-feature-*` dist name resolves directly, per the note above).
[[feature]]
name = "kestrel-feature-observability-fleet"
pypi = ">=0.4,<0.5"
