+    error_type: type[Exception],
+) -> None:
+    original = error_type('Local body read failure')
+
+    class LocalResponse(httpx.Response):
+        async def aread(self) -> bytes:
+            raise original
+
+    def respond(request: httpx.Request) -> httpx.Response:
+        return LocalResponse(
