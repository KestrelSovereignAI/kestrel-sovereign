@prefix kestrel: <https://kestrel.ai/vocab/> .
@prefix kshape: <https://kestrel.ai/shapes/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://kestrel.ai/shapes/> a sh:ShapesGraph ;
    sh:declare [ sh:prefix "kestrel" ; sh:namespace "https://kestrel.ai/vocab/" ] .

kshape:AssertionRevisionShape a sh:NodeShape ;
    sh:targetClass kestrel:AssertionRevision ;
    sh:property [ sh:path kestrel:hasSourceOccurrence ; sh:minCount 1 ] .
